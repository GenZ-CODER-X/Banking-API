from concurrent.futures import ThreadPoolExecutor
from types import SimpleNamespace

from app.services.rate_limiter_service import is_request_allowed


key_string_data = SimpleNamespace(
    key="user_id",
    value="concurrent_test"
)

endpoint = "/test-concurrent"


def send_request(_):
    return is_request_allowed(
        endpoint,
        key_string_data
    )


with ThreadPoolExecutor(max_workers=10) as executor:
    results = list(executor.map(send_request, range(10)))


for i, result in enumerate(results, 1):
    print(f"Request {i}: {result}")

print("Allowed:", results.count(True))
print("Rejected:", results.count(False))
